<Window x:Class="overloadstop_calibrator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:overloadstop_calibrator"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <ComboBox x:Name="cmbPort" HorizontalAlignment="Left" Margin="58,34,0,0" VerticalAlignment="Top" Width="147" Height="43" FontSize="16" VerticalContentAlignment="Center"/>
        <ComboBox x:Name="cmbBaudRate" HorizontalAlignment="Left" Margin="295,34,0,0" VerticalAlignment="Top" Width="147" Height="43" FontSize="16" VerticalContentAlignment="Center"/>
        <Button x:Name="btnConnect" Content="Connect" HorizontalAlignment="Left" Margin="594,34,0,0" VerticalAlignment="Top" Height="43" Width="147" FontSize="18" FontWeight="Bold" Click="btnConnect_Click"/>
        <Label x:Name="lblDisplay" Content="0.00000" HorizontalAlignment="Center" VerticalAlignment="Center" Width="460" Height="106" FontSize="36" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
    </Grid>
</Window>